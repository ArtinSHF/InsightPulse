# ---------- Supabase (Auth + Postgres) ----------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...
# Project Settings -> API -> "service_role" key (SECRET — server only, never expose)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret-key...

# ---------- Gemini (optional server-side fallback) ----------
# Users can also paste their own key in the app's Settings modal.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...your-gemini-api-key...

# ---------- Cloudflare Turnstile (login-page bot detection only) ----------
# Cloudflare Dashboard -> Turnstile -> your site widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...your-site-key...
# "Secret Key" — also paste this into Supabase Dashboard
#   -> Authentication -> Bot and Abuse Protection -> Captcha secret
TURNSTILE_SECRET_KEY=0x4AAAAAAA...your-secret-key...

# ---------- App URL (used for OAuth redirects in production) ----------
# Local: http://localhost:3000   |   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
